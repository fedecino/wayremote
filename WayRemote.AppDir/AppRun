[ -z "$xdg_de" ] && xdg_de=$(echo "${XDG_CURRENT_DESKTOP:-}" | tr "[:upper:]" "[:lower:]")
sess_de=$(echo "$sys_env" | grep -E "^DESKTOP_SESSION=" | cut -d"=" -f2 | tr "[:upper:]" "[:lower:]" || true)
[ -z "$sess_de" ] && sess_de=$(echo "${DESKTOP_SESSION:-}" | tr "[:upper:]" "[:lower:]")

proc_de=""
if pgrep -u "$USER" -f "cinnamon-session|cinnamon|muffin" >/dev/null 2>&1; then proc_de="cinnamon";
elif pgrep -u "$USER" -x gnome-shell >/dev/null 2>&1; then proc_de="gnome";
elif pgrep -u "$USER" -x kwin_wayland >/dev/null 2>&1; then proc_de="plasma";
elif pgrep -u "$USER" -f "cosmic-comp|cosmic-session" >/dev/null 2>&1; then proc_de="cosmic";
elif pgrep -u "$USER" -x niri >/dev/null 2>&1; then proc_de="niri";
elif pgrep -u "$USER" -x sway >/dev/null 2>&1; then proc_de="sway";
elif pgrep -u "$USER" -i -x hyprland >/dev/null 2>&1; then proc_de="hyprland";
elif pgrep -u "$USER" -x labwc >/dev/null 2>&1; then proc_de="labwc";
elif pgrep -u "$USER" -x wayfire >/dev/null 2>&1; then proc_de="wayfire";
elif pgrep -u "$USER" -x river >/dev/null 2>&1; then proc_de="river";
elif pgrep -u "$USER" -f "lxqt-session" >/dev/null 2>&1; then proc_de="lxqt";
elif pgrep -u "$USER" -f "mate-session" >/dev/null 2>&1; then proc_de="mate";
elif pgrep -u "$USER" -f "xfce4-session" >/dev/null 2>&1; then proc_de="xfce";
elif pgrep -u "$USER" -f "budgie-desktop" >/dev/null 2>&1; then proc_de="budgie";
elif pgrep -u "$USER" -f "dde-session|deepin" >/dev/null 2>&1; then proc_de="deepin";
elif pgrep -u "$USER" -f "gala|pantheon" >/dev/null 2>&1; then proc_de="pantheon";
elif pgrep -u "$USER" -f "enlightenment" >/dev/null 2>&1; then proc_de="enlightenment";
elif pgrep -u "$USER" -x weston >/dev/null 2>&1; then proc_de="weston";
fi

de=""
for cand in "$proc_de" "$xdg_de" "$sess_de"; do
    case "$cand" in
        *cinnamon*|*x-cinnamon*|*mint*) de="cinnamon"; break ;;
        *gnome*) de="gnome"; break ;;
        *plasma*|*kde*) de="plasma"; break ;;
        *cosmic*) de="cosmic"; break ;;
        *niri*) de="niri"; break ;;
        *sway*) de="sway"; break ;;
        *hyprland*) de="hyprland"; break ;;
        *labwc*) de="labwc"; break ;;
        *wayfire*) de="wayfire"; break ;;
        *river*) de="river"; break ;;
        *lxqt*) de="lxqt"; break ;;
        *mate*) de="mate"; break ;;
        *xfce*) de="xfce"; break ;;
        *budgie*) de="budgie"; break ;;
        *deepin*|*dde*) de="deepin"; break ;;
        *pantheon*|*elementary*) de="pantheon"; break ;;
        *enlightenment*) de="enlightenment"; break ;;
        *weston*) de="weston"; break ;;
    esac
done

desktop_session_file=""
if [ -z "$de" ]; then
    if ls /usr/share/wayland-sessions/*cinnamon*.desktop >/dev/null 2>&1 || command -v cinnamon-session >/dev/null 2>&1 || command -v muffin >/dev/null 2>&1; then de="cinnamon";
    elif [ -f /usr/share/wayland-sessions/niri.desktop ] || command -v niri >/dev/null 2>&1; then de="niri";
    elif [ -f /usr/share/wayland-sessions/gnome.desktop ] || [ -f /usr/share/wayland-sessions/gnome-wayland.desktop ] || command -v gnome-shell >/dev/null 2>&1; then de="gnome";
    elif ls /usr/share/wayland-sessions/*plasma* >/dev/null 2>&1 || command -v kwin_wayland >/dev/null 2>&1; then de="plasma";
    elif ls /usr/share/wayland-sessions/*cosmic*.desktop >/dev/null 2>&1 || command -v cosmic-session >/dev/null 2>&1; then de="cosmic";
    elif [ -f /usr/share/wayland-sessions/sway.desktop ] || command -v sway >/dev/null 2>&1; then de="sway";
    elif [ -f /usr/share/wayland-sessions/hyprland.desktop ] || command -v Hyprland >/dev/null 2>&1 || command -v hyprland >/dev/null 2>&1; then de="hyprland";
    elif [ -f /usr/share/wayland-sessions/labwc.desktop ] || command -v labwc >/dev/null 2>&1; then de="labwc";
    elif [ -f /usr/share/wayland-sessions/wayfire.desktop ] || command -v wayfire >/dev/null 2>&1; then de="wayfire";
    elif [ -f /usr/share/wayland-sessions/river.desktop ] || command -v river >/dev/null 2>&1; then de="river";
    elif ls /usr/share/wayland-sessions/*lxqt*.desktop >/dev/null 2>&1 || command -v lxqt-session >/dev/null 2>&1; then de="lxqt";
    elif ls /usr/share/wayland-sessions/*mate*.desktop >/dev/null 2>&1 || command -v mate-session >/dev/null 2>&1; then de="mate";
    elif ls /usr/share/wayland-sessions/*xfce*.desktop >/dev/null 2>&1 || command -v xfce4-session >/dev/null 2>&1; then de="xfce";
    elif ls /usr/share/wayland-sessions/*budgie*.desktop >/dev/null 2>&1 || command -v budgie-desktop >/dev/null 2>&1; then de="budgie";
    elif ls /usr/share/wayland-sessions/*deepin*.desktop >/dev/null 2>&1 || ls /usr/share/wayland-sessions/*dde*.desktop >/dev/null 2>&1 || command -v dde-session >/dev/null 2>&1; then de="deepin";
    elif ls /usr/share/wayland-sessions/*pantheon*.desktop >/dev/null 2>&1 || command -v io.elementary.session >/dev/null 2>&1; then de="pantheon";
    elif ls /usr/share/wayland-sessions/*enlightenment*.desktop >/dev/null 2>&1 || command -v enlightenment_start >/dev/null 2>&1; then de="enlightenment";
    elif [ -f /usr/share/wayland-sessions/weston.desktop ] || command -v weston >/dev/null 2>&1; then de="weston";
    fi
fi

if [ -z "$de" ]; then
    for df in /usr/share/wayland-sessions/*.desktop /usr/local/share/wayland-sessions/*.desktop; do
        if [ -f "$df" ]; then
            de="desktop-session"
            desktop_session_file="$df"
            break
        fi
    done
fi

# Rilevamento automatico di qualsiasi emulatore di terminale presente sul server
term_bin=""
if [ -n "$TERMINAL" ] && command -v "$TERMINAL" >/dev/null 2>&1; then
    term_bin="$TERMINAL"
elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    term_bin="xdg-terminal-exec"
elif command -v x-terminal-emulator >/dev/null 2>&1; then
    term_bin="x-terminal-emulator"
else
    for cand_t in ghostty kitty alacritty foot ptyxis wezterm gnome-terminal konsole xfce4-terminal mate-terminal lxterminal terminator tilix xterm rxvt urxvt; do
        if command -v "$cand_t" >/dev/null 2>&1; then
            term_bin="$cand_t"
            break
        fi
    done
fi
term_bin="${term_bin:-xterm}"

case "$de" in
    cinnamon)
        export XDG_CURRENT_DESKTOP="X-Cinnamon"
        export DESKTOP_SESSION="cinnamon-wayland"
        export XDG_SESSION_TYPE="wayland"
        export GDK_BACKEND="wayland,x11,*"
        export QT_QPA_PLATFORM="wayland;xcb"
        for cf in /usr/share/wayland-sessions/*cinnamon*.desktop /usr/local/share/wayland-sessions/*cinnamon*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                if [ -n "$cmd" ]; then
                    exec $cmd
                fi
            fi
        done
        if command -v cinnamon-session-wayland >/dev/null 2>&1; then
            exec cinnamon-session-wayland
        elif command -v cinnamon-session >/dev/null 2>&1; then
            exec cinnamon-session --session cinnamon-wayland
        elif command -v muffin >/dev/null 2>&1; then
            exec muffin --wayland
        elif command -v cinnamon >/dev/null 2>&1; then
            exec cinnamon --wayland
        else
            exec cinnamon
        fi
        ;;
    gnome)
        export XDG_CURRENT_DESKTOP="GNOME"
        export DESKTOP_SESSION="gnome"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*gnome*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        if command -v gnome-shell >/dev/null 2>&1; then
            exec gnome-shell --wayland
        elif command -v gnome-session >/dev/null 2>&1; then
            exec gnome-session
        fi
        ;;
    plasma)
        export XDG_CURRENT_DESKTOP="KDE"
        export DESKTOP_SESSION="plasmawayland"
        export XDG_SESSION_TYPE="wayland"
        if command -v kwin_wayland >/dev/null 2>&1; then
            exec kwin_wayland --xwayland
        elif command -v startplasma-wayland >/dev/null 2>&1; then
            exec startplasma-wayland
        fi
        ;;
    cosmic)
        export XDG_CURRENT_DESKTOP="COSMIC"
        export DESKTOP_SESSION="cosmic"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*cosmic*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        if command -v cosmic-session >/dev/null 2>&1; then
            exec cosmic-session
        elif command -v cosmic-comp >/dev/null 2>&1; then
            exec cosmic-comp
        fi
        ;;
    niri)
        CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wayremote"
        mkdir -p "$CFG_DIR"
        RUN_CFG="$CFG_DIR/niri_remote_config.kdl"
        echo "// WayRemote Nested Config" > "$RUN_CFG"
        if [ -f "$HOME/.config/niri/config.kdl" ]; then
            echo "include \"$HOME/.config/niri/config.kdl\"" >> "$RUN_CFG"
        fi
        cat << EOF_KDL >> "$RUN_CFG"
binds {
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Return { spawn "$term_bin"; }
}
EOF_KDL
        exec niri --config "$RUN_CFG" -- sh -c "if command -v xwayland-satellite >/dev/null 2>&1; then xwayland-satellite & fi; if command -v dms >/dev/null 2>&1; then dms run & fi; if command -v waybar >/dev/null 2>&1; then waybar & fi; sleep 0.3; if [ -n \"$term_bin\" ] && command -v \"$term_bin\" >/dev/null 2>&1; then \"$term_bin\" & fi; true"
        ;;
    sway)
        exec sway
        ;;
    hyprland)
        if command -v Hyprland >/dev/null 2>&1; then
            exec Hyprland
        else
            exec hyprland
        fi
        ;;
    labwc)
        exec labwc
        ;;
    wayfire)
        exec wayfire
        ;;
    river)
        exec river
        ;;
    lxqt)
        export XDG_CURRENT_DESKTOP="LXQt"
        export DESKTOP_SESSION="lxqt"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*lxqt*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        exec lxqt-session
        ;;
    mate)
        export XDG_CURRENT_DESKTOP="MATE"
        export DESKTOP_SESSION="mate"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*mate*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        exec mate-session
        ;;
    xfce)
        export XDG_CURRENT_DESKTOP="XFCE"
        export DESKTOP_SESSION="xfce"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*xfce*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        exec xfce4-session
        ;;
    budgie)
        export XDG_CURRENT_DESKTOP="Budgie:GNOME"
        export DESKTOP_SESSION="budgie-desktop"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*budgie*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        exec budgie-desktop
        ;;
    deepin)
        export XDG_CURRENT_DESKTOP="DDE"
        export DESKTOP_SESSION="dde"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*deepin*.desktop /usr/share/wayland-sessions/*dde*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        exec dde-session
        ;;
    pantheon)
        export XDG_CURRENT_DESKTOP="Pantheon"
        export DESKTOP_SESSION="pantheon"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*pantheon*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        exec io.elementary.session
        ;;
    enlightenment)
        export XDG_CURRENT_DESKTOP="Enlightenment"
        export DESKTOP_SESSION="enlightenment"
        export XDG_SESSION_TYPE="wayland"
        for cf in /usr/share/wayland-sessions/*enlightenment*.desktop; do
            if [ -f "$cf" ]; then
                cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                [ -n "$cmd" ] && exec $cmd
            fi
        done
        exec enlightenment_start
        ;;
    weston)
        exec weston
        ;;
    desktop-session)
        if [ -n "$desktop_session_file" ] && [ -f "$desktop_session_file" ]; then
            cmd=$(grep -E "^Exec=" "$desktop_session_file" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
            if [ -n "$cmd" ]; then
                exec $cmd
            fi
        fi
        exec "$term_bin"
        ;;
    *)
        for df in /usr/share/wayland-sessions/*.desktop /usr/local/share/wayland-sessions/*.desktop; do
            if [ -f "$df" ]; then
                exec_cand=$(grep -E "^Exec=" "$df" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
                if [ -n "$exec_cand" ]; then
                    bin_cand=$(echo "$exec_cand" | awk "{print \$1}")
                    if command -v "$bin_cand" >/dev/null 2>&1; then
                        exec $exec_cand
                    fi
                fi
            fi
        done
        exec "$term_bin"
        ;;
esac
