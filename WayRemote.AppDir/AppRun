# Connessione Rapida:
# Quando una connessione è già registrata, NON chiede IP e utente, ma chiede SOLO la password!
connect_quick() {
    local count
    count=$(python3 "$CONNECTIONS_PY" count 2>/dev/null || echo 0)

    if [ "$count" -gt 0 ]; then
        local target_id=""
        if [ "$count" -eq 1 ]; then
            target_id=$(python3 "$CONNECTIONS_PY" first-id 2>/dev/null || echo 1)
        else
            # Più profili memorizzati: mostra selezione rapida
            local list_args=()
            while IFS= read -r line; do
                list_args+=("$line")
            done < <(python3 "$CONNECTIONS_PY" list)

            local pick_status=0
            target_id=$(zenity --list \
                --title="Connessione Rapida" \
                --text="Seleziona il computer remoto a cui connetterti:" \
                --column="ID" --column="Nome Server" --column="Indirizzo IP / Host" --column="Utente" --column="Tipo Sessione" \
                --hide-column=1 \
                "${list_args[@]}" \
                --ok-label="Connetti" --cancel-label="Annulla" \
                --height=320 --width=680 2>/dev/null) || pick_status=$?

            if [ "$pick_status" -ne 0 ] || [ -z "$target_id" ]; then
                return 1
            fi
        fi

        # Connessione registrata: chiede SOLO la password tramite connect_profile
        connect_profile "$target_id"
        return $?
    fi

    # Fallback se non ci sono ancora connessioni salvate
    connect_manual
}

# Connessione manuale a un nuovo host non salvato
connect_manual() {
    local remote_ip=""
    local r_status=0
    remote_ip=$(zenity --entry --title="Connessione Manuale" --text="Inserisci l'indirizzo IP del server:" --entry-text="192.168.1." 2>/dev/null) || r_status=$?
    if [ "$r_status" -ne 0 ] || [ -z "$remote_ip" ]; then return 1; fi

    local remote_user=""
    local u_status=0
    remote_user=$(zenity --entry --title="Connessione Manuale" --text="Inserisci il nome utente:" --entry-text="$USER" 2>/dev/null) || u_status=$?
    if [ "$u_status" -ne 0 ] || [ -z "$remote_user" ]; then return 1; fi

    local remote_pass=""
    local p_status=0
    remote_pass=$(zenity --password --title="Password SSH" --text="Inserisci la password per <b>${remote_user}@${remote_ip}</b>:\n<i>(Lascia vuoto se hai già configurato la chiave SSH pubblica)</i>" 2>/dev/null) || p_status=$?
    if [ "$p_status" -ne 0 ]; then return 1; fi

    launch_session "$remote_ip" "$remote_user" "$remote_pass" "auto" ""
    return $?
}

# Connessione a un profilo memorizzato (NON chiede IP o utente, chiede SOLO la password!)
connect_profile() {
    local prof_id="$1"
    local get_vars
    get_vars=$(python3 "$CONNECTIONS_PY" get "$prof_id" 2>/dev/null) || {
        zenity --error --text="Impossibile caricare il profilo selezionato." 2>/dev/null || true
        return 1
    }
    eval "$get_vars"

    local remote_pass=""
    local p_status=0
    remote_pass=$(zenity --password \
        --title="WayRemote - Password per ${CONN_NAME}" \
        --text="Inserisci la password per <b>${CONN_USER}@${CONN_HOST}</b>:\n<i>(Lascia vuoto se hai già configurato la chiave SSH pubblica)</i>" 2>/dev/null) || p_status=$?
    if [ "$p_status" -ne 0 ]; then
        return 1
    fi

    launch_session "$CONN_HOST" "$CONN_USER" "$remote_pass" "$CONN_SESSION" "$CONN_CUSTOM_CMD"
    return $?
}

# Avvio effettivo della sessione Waypipe / SSH
launch_session() {
    local remote_ip="$1"
    local remote_user="$2"
    local remote_pass="$3"
    local session_choice="$4"
    local custom_cmd="$5"

    # Assicura DISPLAY e WAYLAND_DISPLAY corretti per client Wayland/X11 e dialoghi SSH_ASKPASS
    if [ -z "${DISPLAY:-}" ]; then
        for xsock in /tmp/.X11-unix/X*; do
            if [ -S "$xsock" ]; then
                disp_num=$(basename "$xsock" | sed 's/^X//')
                export DISPLAY=":$disp_num"
                break
            fi
        done
    fi
    export DISPLAY="${DISPLAY:-:0}"

    local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export XDG_RUNTIME_DIR="$runtime_dir"
    if [ -z "${WAYLAND_DISPLAY:-}" ] || [ ! -S "${runtime_dir}/${WAYLAND_DISPLAY}" ]; then
        for sock in "$runtime_dir"/wayland-*; do
            if [ -S "$sock" ] && [[ ! "$sock" =~ waypipe ]] && [ -f "${sock}.lock" ]; then
                export WAYLAND_DISPLAY="$(basename "$sock")"
                break
            fi
        done
        if [ -z "${WAYLAND_DISPLAY:-}" ] || [ ! -S "${runtime_dir}/${WAYLAND_DISPLAY}" ]; then
            for sock in "$runtime_dir"/wayland-*; do
                if [ -S "$sock" ] && [[ ! "$sock" =~ waypipe ]]; then
                    export WAYLAND_DISPLAY="$(basename "$sock")"
                    break
                fi
            done
        fi
    fi

    # Script helper per SSH_ASKPASS (con codifica Base64 per preservare caratteri speciali della password)
    local askpass_script
    askpass_script=$(mktemp /tmp/wayremote_askpass.XXXXXX.sh)
    chmod 700 "$askpass_script"

    local b64_pass=""
    if [ -n "$remote_pass" ]; then
        b64_pass=$(printf '%s' "$remote_pass" | base64 -w 0)
    fi

    cat << EOF > "$askpass_script"
#!/usr/bin/env bash
PROMPT="\${1:-}"
SAVED_PASS_B64="$b64_pass"

if echo "\$PROMPT" | grep -qiE "yes/no|fingerprint|authenticity"; then
    echo "yes"
elif [ -n "\$SAVED_PASS_B64" ]; then
    echo "\$SAVED_PASS_B64" | base64 -d
else
    zenity --password --title="WayRemote - Autenticazione SSH" --text="\$PROMPT" 2>/dev/null
fi
EOF

    local SSH_OPTS=(
        -o StrictHostKeyChecking=accept-new
        -o ConnectTimeout=8
        -o NumberOfPasswordPrompts=1
        -o Compression=no
        -o Ciphers=aes128-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
        -o IPQoS=lowdelay
        -o TCPKeepAlive=yes
        -o ServerAliveInterval=15
    )
    if [ -n "$remote_pass" ]; then
        # Se la password è specificata, forza autenticazione password
        # ed escludi chiavi pubbliche per evitare "Too many authentication failures" da ssh-agent
        SSH_OPTS+=(-o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive)
    else
        SSH_OPTS+=(-o PreferredAuthentications=publickey,keyboard-interactive,password)
    fi

    # 1. PRE-FLIGHT CHECK: Verifica Connettività e Credenziali SSH
    local check_output
    check_output=$(export SSH_ASKPASS="$askpass_script" SSH_ASKPASS_REQUIRE="force"; \
        ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "echo __WAYREMOTE_AUTH_OK__" 2>&1) || {
        
        if echo "$check_output" | grep -qi "Permission denied"; then
            zenity --error --title="Autenticazione Fallita" \
                --text="<b>Password o Nome Utente non corretti.</b>\n\nImpossibile accedere come utente <b>${remote_user}</b> su <b>${remote_ip}</b>.\nVerifica che la password digitata sia corretta." \
                --width=460 2>/dev/null || true
        elif echo "$check_output" | grep -qi "Too many authentication failures"; then
            zenity --error --title="Troppi Tentativi con Chiavi SSH" \
                --text="<b>Il server ha rifiutato la connessione per troppi tentativi con chiavi SSH.</b>\n\nIl tuo ssh-agent contiene molte chiavi che hanno esaurito i tentativi massimi del server.\n\n<b>Soluzione:</b> Inserisci la <b>password</b> quando richiesta per accedere direttamente con password." \
                --width=500 2>/dev/null || true
        elif echo "$check_output" | grep -qi "Connection refused"; then
            zenity --error --title="Server Non Raggiungibile" \
                --text="<b>Connessione rifiutata da ${remote_ip}:22.</b>\n\nIl server SSH non risulta in esecuzione sul target.\nSul PC server esegui:\n<tt>sudo systemctl enable --now sshd</tt> (oppure <tt>ssh</tt>)" \
                --width=480 2>/dev/null || true
        elif echo "$check_output" | grep -qiE "No route to host|timed out|Could not resolve"; then
            zenity --error --title="Host Non Raggiungibile" \
                --text="<b>Impossibile raggiungere l'indirizzo IP ${remote_ip}.</b>\n\nVerifica che entrambi i PC siano accesi e collegati alla stessa rete LAN o VPN." \
                --width=480 2>/dev/null || true
        else
            zenity --error --title="Errore Connessione SSH" \
                --text="<b>Errore di connessione verso ${remote_user}@${remote_ip}:</b>\n\n${check_output}" \
                --width=500 2>/dev/null || true
        fi
        rm -f "$askpass_script"
        return 1
    }

    # 2. PROBE AMBIENTE SERVER: Rilevamento automatico Wayland vs X11 e accelerazione video
    local server_info
    server_info=$(export SSH_ASKPASS="$askpass_script" SSH_ASKPASS_REQUIRE="force"; \
        ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" '
has_waypipe=0; command -v waypipe >/dev/null 2>&1 && has_waypipe=1
has_wp_video=0; waypipe -V 2>/dev/null | grep -qiE "video:\s*true" && has_wp_video=1
has_xwls=0; command -v xwayland-satellite >/dev/null 2>&1 && has_xwls=1
has_wayland_sess=0; ls /usr/share/wayland-sessions/*.desktop >/dev/null 2>&1 && has_wayland_sess=1
has_xsess=0; ls /usr/share/xsessions/*.desktop >/dev/null 2>&1 && has_xsess=1
sys_env=$(systemctl --user show-environment 2>/dev/null || true)
xdg_type=$(echo "$sys_env" | grep -E "^XDG_SESSION_TYPE=" | cut -d"=" -f2 || true)
[ -z "$xdg_type" ] && xdg_type="${XDG_SESSION_TYPE:-}"
has_wayland_bin=0
for cand_wb in niri gnome-shell kwin_wayland cosmic-session sway Hyprland hyprland labwc wayfire river cinnamon-session-wayland weston; do
    if command -v "$cand_wb" >/dev/null 2>&1; then
        has_wayland_bin=1
        break
    fi
done
echo "WAYPIPE=$has_waypipe;WP_VIDEO=$has_wp_video;XWLS=$has_xwls;WAYLAND_SESS=$has_wayland_sess;WAYLAND_BIN=$has_wayland_bin;XSESS=$has_xsess;XDG_TYPE=$xdg_type"
' 2>/dev/null || echo "WAYPIPE=0;WP_VIDEO=0;XWLS=0;WAYLAND_SESS=0;WAYLAND_BIN=0;XSESS=0;XDG_TYPE=unknown")

    local srv_waypipe=0 srv_wp_video=0 srv_xwls=0 srv_wayland_sess=0 srv_wayland_bin=0 srv_xsess=0 srv_xdg_type="unknown"
    [[ "$server_info" =~ WAYPIPE=([0-9]) ]] && srv_waypipe="${BASH_REMATCH[1]}"
    [[ "$server_info" =~ WP_VIDEO=([0-9]) ]] && srv_wp_video="${BASH_REMATCH[1]}"
    [[ "$server_info" =~ XWLS=([0-9]) ]] && srv_xwls="${BASH_REMATCH[1]}"
    [[ "$server_info" =~ WAYLAND_SESS=([0-9]) ]] && srv_wayland_sess="${BASH_REMATCH[1]}"
    [[ "$server_info" =~ WAYLAND_BIN=([0-9]) ]] && srv_wayland_bin="${BASH_REMATCH[1]}"
    [[ "$server_info" =~ XSESS=([0-9]) ]] && srv_xsess="${BASH_REMATCH[1]}"
    [[ "$server_info" =~ XDG_TYPE=([a-zA-Z0-9_-]+) ]] && srv_xdg_type="${BASH_REMATCH[1]}"

    local cli_wp_video=0
    if command -v waypipe >/dev/null 2>&1 && waypipe -V 2>/dev/null | grep -qiE "video:\s*true"; then
        cli_wp_video=1
    fi

    local is_lan=0
    if [[ "$remote_ip" =~ ^(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.|localhost) ]]; then
        is_lan=1
    fi

    local conn_mode="wayland"
    if [ "$session_choice" = "x11" ]; then
        conn_mode="x11"
    elif [ "$srv_waypipe" -eq 1 ] && ( [ "$srv_wayland_sess" -eq 1 ] || [ "$srv_wayland_bin" -eq 1 ] ); then
        conn_mode="wayland"
    elif [ "$srv_waypipe" -eq 0 ] || ( [ "$srv_wayland_sess" -eq 0 ] && [ "$srv_wayland_bin" -eq 0 ] ); then
        conn_mode="x11"
    fi

    # 3. COSTRUZIONE DEL COMANDO REMOTO
    local remote_cmd=""
    if [ "$conn_mode" = "x11" ]; then
        case "$session_choice" in
