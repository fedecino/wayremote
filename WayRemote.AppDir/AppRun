# Menu principale interattivo
main_menu() {
    local choice
    choice=$(zenity --list --radiolist \
        --title="WayRemote - Remote Login Wayland" \
        --text="Seleziona l'operazione desiderata:" \
        --column="Seleziona" --column="Codice" --column="Operazione" \
        TRUE  "CLIENT"  "1. Connettiti a un PC remoto (Client)" \
        FALSE "SERVER"  "2. Configura questo PC come SERVER (riceve connessioni)" \
        FALSE "INSTALL" "3. Installa WayRemote nel sistema (Integrazione Desktop)" \
        --height=240 --width=520 --hide-column=2) || exit 0

    case "$choice" in
        CLIENT)
            flow_client
            ;;
        SERVER)
            flow_server
            ;;
        INSTALL)
            flow_install
            ;;
        *)
            exit 0
            ;;
    esac
}

