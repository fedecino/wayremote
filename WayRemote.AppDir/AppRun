#!/usr/bin/env bash
# ==============================================================================
# WayRemote - Utility Universale per Remote Login Wayland
# ==============================================================================
set -euo pipefail

# Determinazione della directory dell'AppDir
APPDIR="${APPDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
APPIMAGE_BIN="${APPIMAGE:-$0}"

# Verifica se libfuse.so.2 è presente nel sistema
check_fuse() {
    if ldconfig -p 2>/dev/null | grep -q "libfuse\.so\.2"; then
        return 0
    fi
    for path in /usr/lib/libfuse.so.2 /usr/lib64/libfuse.so.2 /lib/x86_64-linux-gnu/libfuse.so.2 /lib64/libfuse.so.2 /usr/lib/x86_64-linux-gnu/libfuse.so.2; do
        if [ -f "$path" ]; then
            return 0
        fi
    done
    return 1
}

# Funzione per verificare ed autoinstallare le dipendenze essenziali (zenity, fuse2)
ensure_system_dependencies() {
    local need_zenity=0
    local need_fuse=0

    if ! command -v zenity &>/dev/null; then
        need_zenity=1
    fi

    if ! check_fuse; then
        need_fuse=1
    fi

    # Se tutto è già presente, procedi subito
    if [ "$need_zenity" -eq 0 ] && [ "$need_fuse" -eq 0 ]; then
        return 0
    fi

    detect_distro
    local missing_pkgs=""
    local install_cmd=""

    case "$DISTRO_ID" in
        arch|cachyos|endeavouros|manjaro|artix)
            [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
            [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs fuse2"
            install_cmd="pacman -S --noconfirm $missing_pkgs"
            ;;
        debian|ubuntu|linuxmint|pop|elementary|zorin)
            [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
            [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs libfuse2"
            install_cmd="apt-get update && apt-get install -y $missing_pkgs"
            ;;
        fedora|rhel|centos|almalinux|rocky)
            [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
            [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs fuse-libs"
            install_cmd="dnf install -y $missing_pkgs"
            ;;
        opensuse*|suse)
            [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
            [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs libfuse2"
            install_cmd="zypper install -y $missing_pkgs"
            ;;
        *)
            if [[ "$DISTRO_LIKE" =~ arch ]]; then
                [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
                [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs fuse2"
                install_cmd="pacman -S --noconfirm $missing_pkgs"
            elif [[ "$DISTRO_LIKE" =~ debian|ubuntu ]]; then
                [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
                [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs libfuse2"
                install_cmd="apt-get update && apt-get install -y $missing_pkgs"
            elif [[ "$DISTRO_LIKE" =~ fedora|rhel ]]; then
                [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
                [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs fuse-libs"
                install_cmd="dnf install -y $missing_pkgs"
            else
                [ "$need_zenity" -eq 1 ] && missing_pkgs="$missing_pkgs zenity"
                [ "$need_fuse" -eq 1 ] && missing_pkgs="$missing_pkgs fuse2"
                install_cmd="pacman -S --noconfirm $missing_pkgs"
            fi
            ;;
    esac

    # 1. Tentativo tramite pkexec (popup grafico nativo di autenticazione del desktop)
    if command -v pkexec &>/dev/null; then
        if pkexec sh -c "$install_cmd" 2>/dev/null; then
            if ([ "$need_zenity" -eq 0 ] || command -v zenity &>/dev/null) && ([ "$need_fuse" -eq 0 ] || check_fuse); then
                return 0
            fi
        fi
    fi

    # 2. Fallback tramite finestra di terminale
    local term
    term=$(find_terminal)
    if [ -n "$term" ]; then
        case "$term" in
            ghostty)
                "$term" -e bash -c "echo '==> [WayRemote] Installazione dipendenze di sistema ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            kitty)
                "$term" --title "WayRemote - Setup Dipendenze" bash -c "echo '==> [WayRemote] Installazione dipendenze ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            alacritty)
                "$term" -T "WayRemote - Setup Dipendenze" -e bash -c "echo '==> [WayRemote] Installazione dipendenze ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            foot)
                "$term" -T "WayRemote - Setup Dipendenze" bash -c "echo '==> [WayRemote] Installazione dipendenze ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            ptyxis)
                "$term" -- bash -c "echo '==> [WayRemote] Installazione dipendenze ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            wezterm)
                "$term" start -- bash -c "echo '==> [WayRemote] Installazione dipendenze ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            gnome-terminal)
                "$term" --title="WayRemote - Setup Dipendenze" -- bash -c "echo '==> [WayRemote] Installazione dipendenze ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            konsole)
                "$term" -p tabtitle="WayRemote - Setup Dipendenze" -e bash -c "echo '==> [WayRemote] Installazione dipendenze ($missing_pkgs)...'; sudo $install_cmd; sleep 1"
                ;;
            xfce4-terminal|mate-terminal|lxterminal|terminator|tilix)
                "$term" -T "WayRemote - Setup Dipendenze" -e "bash -c 'echo [WayRemote] Installazione dipendenze...; sudo $install_cmd; sleep 1'"
                ;;
            *)
                "$term" -e bash -c "sudo $install_cmd; sleep 1"
                ;;
        esac
    fi

    if [ "$need_zenity" -eq 1 ] && ! command -v zenity &>/dev/null; then
        echo "[WayRemote] ERRORE: Impossibile installare automaticamente 'zenity'." >&2
        exit 1
    fi
}

# Rilevamento della distribuzione Linux
detect_distro() {
    if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        DISTRO_ID="${ID:-unknown}"
        DISTRO_LIKE="${ID_LIKE:-}"
    else
        DISTRO_ID="unknown"
        DISTRO_LIKE=""
    fi
}

# Rilevamento di qualsiasi emulatore di terminale disponibile
find_terminal() {
    # 1. Variabile d'ambiente $TERMINAL se impostata dall'utente
    if [ -n "${TERMINAL:-}" ] && command -v "$TERMINAL" &>/dev/null; then
        echo "$TERMINAL"
        return 0
    fi

    # 2. xdg-terminal-exec se disponibile
    if command -v xdg-terminal-exec &>/dev/null; then
        echo "xdg-terminal-exec"
        return 0
    fi

    local terminals=(
        "ghostty"
        "kitty"
        "alacritty"
        "foot"
        "ptyxis"
        "wezterm"
        "gnome-terminal"
        "konsole"
        "xfce4-terminal"
        "mate-terminal"
        "lxterminal"
        "x-terminal-emulator"
        "terminator"
        "tilix"
        "xterm"
    )

    for term in "${terminals[@]}"; do
        if command -v "$term" &>/dev/null; then
            echo "$term"
            return 0
        fi
    done
    echo ""
}

# Flusso Configurazione SERVER
flow_server() {
    detect_distro
    local pkg_manager=""
    local install_cmd=""
    local service_name="sshd"

    case "$DISTRO_ID" in
        arch|cachyos|endeavouros|manjaro|artix)
            pkg_manager="pacman"
            install_cmd="pacman -S --noconfirm --needed openssh waypipe fuse2 xorg-xauth xwayland-satellite ffmpeg intel-media-driver libva-mesa-driver libva-utils"
            service_name="sshd"
            ;;
        debian|ubuntu|linuxmint|pop|elementary|zorin)
            pkg_manager="apt"
            install_cmd="apt-get update && apt-get install -y openssh-server waypipe libfuse2 xauth ffmpeg va-driver-all vainfo mesa-va-drivers"
            service_name="ssh"
            ;;
        fedora|rhel|centos|almalinux|rocky)
            pkg_manager="dnf"
            install_cmd="dnf install -y openssh-server waypipe fuse-libs xorg-x11-xauth ffmpeg mesa-va-drivers libva-utils intel-media-driver"
            service_name="sshd"
            ;;
        opensuse*|suse)
            pkg_manager="zypper"
            install_cmd="zypper install -y openssh waypipe libfuse2 xauth ffmpeg libva-utils"
            service_name="sshd"
            ;;
        *)
            if [[ "$DISTRO_LIKE" =~ arch ]]; then
                pkg_manager="pacman"
                install_cmd="pacman -S --noconfirm --needed openssh waypipe fuse2 xorg-xauth xwayland-satellite ffmpeg intel-media-driver libva-mesa-driver libva-utils"
                service_name="sshd"
            elif [[ "$DISTRO_LIKE" =~ debian|ubuntu ]]; then
                pkg_manager="apt"
                install_cmd="apt-get update && apt-get install -y openssh-server waypipe libfuse2 xauth ffmpeg va-driver-all vainfo mesa-va-drivers"
                service_name="ssh"
            elif [[ "$DISTRO_LIKE" =~ fedora|rhel ]]; then
                pkg_manager="dnf"
                install_cmd="dnf install -y openssh-server waypipe fuse-libs xorg-x11-xauth ffmpeg mesa-va-drivers libva-utils intel-media-driver"
                service_name="sshd"
            else
                zenity --error --title="Distribuzione non supportata" \
                    --text="Distribuzione rilevata ($DISTRO_ID) non supportata automaticamente per l'installazione dei pacchetti.\n\nInstalla manualmente: openssh, waypipe, ffmpeg e driver VA-API/xauth, poi avvia il servizio SSH." \
                    --width=450
                return 1
            fi
            ;;
    esac

    # Conferma utente
    if ! zenity --question --title="Configurazione Server WayRemote" \
        --text="<b>Distribuzione rilevata:</b> ${DISTRO_ID} (${pkg_manager})\n\nVerranno installati e configurati per le massime prestazioni:\n• <b>Server OpenSSH</b> (ottimizzato per low-latency e socket forwarding)\n• <b>Waypipe</b> (inoltro sessioni grafiche Wayland)\n• <b>Accelerazione Hardware Video GPU</b> (FFmpeg e driver VA-API Intel/AMD/Nvidia)\n• <b>Supporto X11 Forwarding</b> (xauth, xwayland-satellite)\n• <b>Permessi hardware utente</b> (gruppi video e render)\n\nVuoi procedere con l'installazione e l'avvio del servizio SSH?" \
        --ok-label="Procedi" --cancel-label="Annulla" --width=460; then
        return 0
    fi

    # Richiesta password sudo
    local sudo_pass=""
    sudo_pass=$(zenity --password --title="Autenticazione Richiesta" \
        --text="Inserisci la password di amministrazione (sudo) per configurare il sistema:") || return 0

    if [ -z "$sudo_pass" ]; then
        zenity --error --text="Password non inserita. Operazione annullata."
        return 1
    fi

    # Esecuzione script di setup con barra di progresso
    (
        echo "10"; echo "# Aggiornamento repository e installazione pacchetti..."
        if ! echo "$sudo_pass" | sudo -S -- sh -c "$install_cmd" 2>&1; then
            echo "ERROR"
            exit 1
        fi

        echo "50"; echo "# Configurazione di SSH e accelerazione hardware GPU..."
        echo "$sudo_pass" | sudo -S -- sh -c '
            mkdir -p /etc/ssh/sshd_config.d
            cat << "EOF" > /etc/ssh/sshd_config.d/wayremote.conf
# WayRemote High-Performance SSH Configuration
PasswordAuthentication yes
KbdInteractiveAuthentication yes
UsePAM yes
X11Forwarding yes
StreamLocalBindUnlink yes
TCPKeepAlive yes
Compression no
IPQoS lowdelay
EOF
            # Aggiunge l'\''utente corrente ai gruppi render e video per abilitare l'\''accesso diretto alla GPU
            for grp in render video; do
                if getent group "$grp" >/dev/null 2>&1; then
                    usermod -aG "$grp" "'"$USER"'" 2>/dev/null || true
                fi
            done
        ' 2>&1 || true

        echo "70"; echo "# Abilitazione e riavvio del servizio SSH ($service_name)..."
        if ! echo "$sudo_pass" | sudo -S -- sh -c "systemctl enable --now $service_name || systemctl enable --now ssh || systemctl enable --now sshd; systemctl restart $service_name || systemctl restart ssh || systemctl restart sshd" 2>&1; then
            echo "ERROR"
            exit 1
        fi

        echo "85"; echo "# Configurazione del firewall (apertura porta 22 per SSH)..."
        echo "$sudo_pass" | sudo -S -- sh -c '
            if command -v ufw >/dev/null 2>&1 && systemctl is-active --quiet ufw; then
                ufw allow 22/tcp || ufw allow ssh || true
                ufw reload || true
            fi
            if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld; then
                firewall-cmd --permanent --add-service=ssh >/dev/null 2>&1 || true
                firewall-cmd --reload >/dev/null 2>&1 || true
            fi
        ' 2>&1 || true

        echo "100"; echo "# Configurazione completata con successo!"
        sleep 1
    ) | zenity --progress --title="Installazione Server WayRemote" --percentage=0 --auto-close --width=400

    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
        zenity --error --title="Errore Installazione" \
            --text="Si è verificato un errore durante l'installazione dei pacchetti o l'avvio di SSH.\nVerifica che la password sia corretta e che la connessione internet sia attiva." \
            --width=420
        return 1
    fi

    # Successo
    local ip_lan
    ip_lan=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "indirizzo-ip-lan")
    
    zenity --info --title="Server WayRemote Pronto" \
        --text="<b>Configurazione completata!</b>\n\nQuesto computer è ora pronto a ricevere connessioni remote Wayland.\n\n• <b>IP LAN:</b> ${ip_lan}\n• <b>Utente:</b> ${USER}\n• <b>Servizio:</b> SSH attivo (Porta 22 aperta)" \
        --width=420

    # Chiede se installare il client su questa stessa macchina
    if zenity --question --title="Integrazione Desktop Client" \
        --text="Desideri installare e integrare il Client WayRemote anche nel menu applicazioni di questo PC?" \
        --ok-label="Sì, integra" --cancel-label="No, grazie"; then
        flow_install
    fi
}

# Flusso INSTALLAZIONE CLIENT (Integrazione Desktop)
flow_install() {
    local target_bin_dir="$HOME/.local/bin"
    local target_icon_dir="$HOME/.local/share/icons/hicolor/128x128/apps"
    local target_pixmaps="$HOME/.local/share/pixmaps"
    local target_app_dir="$HOME/.local/share/applications"
    local target_bin="$target_bin_dir/wayremote"
    local target_desktop="$target_app_dir/wayremote.desktop"

    mkdir -p "$target_bin_dir" "$target_icon_dir" "$target_pixmaps" "$target_app_dir"

    # Copia l'AppImage (o l'eseguibile corrente)
    if [ -n "${APPIMAGE:-}" ] && [ -f "$APPIMAGE" ]; then
        cp -f "$APPIMAGE" "$target_bin"
    elif [ -f "$0" ]; then
        cp -f "$0" "$target_bin"
    else
        # Se avviato dall'AppDir scompattata
        cat << 'EOF' > "$target_bin"
#!/usr/bin/env bash
exec /usr/bin/env wayremote "$@"
EOF
    fi
    chmod +x "$target_bin"

    # Copia Icona
    if [ -f "$APPDIR/wayremote.png" ]; then
        cp -f "$APPDIR/wayremote.png" "$target_icon_dir/wayremote.png"
        cp -f "$APPDIR/wayremote.png" "$target_pixmaps/wayremote.png"
    fi

    # Crea desktop entry
    cat << EOF > "$target_desktop"
[Desktop Entry]
Type=Application
Name=WayRemote
GenericName=Remote Desktop Wayland
Comment=Accesso Desktop Remoto Wayland nativo via waypipe e SSH
Exec=$target_bin --client
Icon=wayremote
Terminal=false
Categories=Network;RemoteAccess;Utility;
Keywords=Wayland;Remote;Desktop;SSH;waypipe;niri;
StartupNotify=true
EOF
    chmod +x "$target_desktop"

    # Aggiorna database applicazioni se disponibile
    if command -v update-desktop-database &>/dev/null; then
        update-desktop-database "$target_app_dir" 2>/dev/null || true
    fi
    if command -v gtk-update-icon-cache &>/dev/null; then
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
    fi

    local path_warning=""
    if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
        path_warning="\n\n<i>Nota: Assicurati che <b>~/.local/bin</b> sia incluso nel tuo \$PATH.</i>"
    fi

    zenity --info --title="Integrazione Completata" \
        --text="<b>WayRemote installato con successo!</b>\n\n• Eseguibile: <tt>$target_bin</tt>\n• Desktop Entry: <tt>$target_desktop</tt>\n• Icona: <tt>$target_icon_dir/wayremote.png</tt>\n\nTroverai WayRemote nel menu applicazioni del tuo desktop.$path_warning" \
        --width=450
}

# Helper per il Connection Manager
CONNECTIONS_PY="$APPDIR/connections.py"

# Flusso CLIENT (Gestione Connessioni in stile GNOME-RDP / Remmina)
flow_client() {
    # Controllo dipendenze client
    if ! command -v waypipe &>/dev/null; then
        if zenity --question --title="Waypipe mancante" \
            --text="<b>'waypipe' non è installato su questo sistema client.</b>\n\nÈ necessario per inoltrare la sessione grafica Wayland.\nVuoi installarlo ora tramite il configuratore Server/Dipendenze?" \
            --ok-label="Configura dipendenze" --cancel-label="Annulla"; then
            flow_server
            return
        else
            return 1
        fi
    fi

    if ! command -v ssh &>/dev/null; then
        zenity --error --text="Il comando 'ssh' (OpenSSH client) non è presente nel sistema."
        return 1
    fi

    # Inizializza il file delle connessioni se non presente
    python3 "$CONNECTIONS_PY" init >/dev/null 2>&1 || true

    while true; do
        local count
        count=$(python3 "$CONNECTIONS_PY" count 2>/dev/null || echo 0)

        if [ "$count" -eq 0 ]; then
            if zenity --question --title="WayRemote - Nessuna Connessione" \
                --text="Non hai ancora salvato alcun computer remoto.\n\nVuoi aggiungere una nuova connessione adesso?" \
                --ok-label="Aggiungi Connessione" --cancel-label="Esci"; then
                form_add_connection
                continue
            else
                return 0
            fi
        fi

        # Carica la lista dei profili per zenity
        local list_args=()
        while IFS= read -r line; do
            list_args+=("$line")
        done < <(python3 "$CONNECTIONS_PY" list)

        local action_out=""
        local zenity_status=0
        action_out=$(zenity --list \
            --title="WayRemote - Gestione Connessioni Desktop Remoto" \
            --text="<b>Computer Remoti Memorizzati:</b>\nSeleziona una connessione e premi <b>Connetti</b> (o fai doppio clic):" \
            --column="ID" --column="Nome Server" --column="Indirizzo IP / Host" --column="Utente" --column="Tipo Sessione" \
            --hide-column=1 \
            "${list_args[@]}" \
            --ok-label="Connetti" \
            --cancel-label="Chiudi" \
            --extra-button="+ Nuovo" \
            --extra-button="Modifica" \
            --extra-button="Elimina" \
            --extra-button="Connessione Rapida" \
            --extra-button="Altro IP..." \
            --height=380 --width=720 2>/dev/null) || zenity_status=$?

        # Se l'utente ha cliccato Chiudi o chiuso la finestra con la X
        if [ "$zenity_status" -ne 0 ] && [ -z "$action_out" ]; then
            return 0
        fi

        # Se ha premuto Connetti ma non ha selezionato manualmente una riga:
        # Se c'è almeno un profilo salvato, connettiti automaticamente al primo chiedendo SOLO la password!
        if [ "$zenity_status" -eq 0 ] && [ -z "$action_out" ]; then
            if [ "$count" -ge 1 ]; then
                local def_id
                def_id=$(python3 "$CONNECTIONS_PY" first-id 2>/dev/null || echo 1)
                if connect_profile "$def_id"; then
                    return 0
                fi
                continue
            fi
            zenity --info --title="Nessuna Selezione" \
                --text="Seleziona un computer remoto dalla lista prima di cliccare <b>Connetti</b>." \
                --width=380 2>/dev/null || true
            continue
        fi

        case "$action_out" in
            *"+ Nuovo"*)
                form_add_connection
                ;;
            *"Modifica"*)
                form_edit_connection
                ;;
            *"Elimina"*)
                form_delete_connection
                ;;
            *"Connessione Rapida"*)
                if connect_quick; then
                    return 0
                fi
                ;;
            *"Altro IP"*)
                if connect_manual; then
                    return 0
                fi
                ;;
            *)
                # È stato selezionato un ID riga e premuto Connetti (o doppio clic)
                if [ -n "$action_out" ]; then
                    if connect_profile "$action_out"; then
                        return 0
                    fi
                fi
                ;;
        esac
    done
}

# Form Aggiungi Connessione
form_add_connection() {
    local form_res=""
    local f_status=0
    form_res=$(zenity --forms \
        --title="Aggiungi Computer Remoto" \
        --text="Inserisci i dati per memorizzare il nuovo client/server:" \
        --add-entry="Nome Connessione (es. ThinkPad Ufficio)" \
        --add-entry="Indirizzo IP o Host (es. 192.168.4.162)" \
        --add-entry="Nome Utente (es. $USER)" \
        --add-combo="Sessione Remota" \
        --combo-values="Rilevamento Automatico (Wayland o X11 - Consigliato)|Cinnamon Desktop (Linux Mint Wayland)|GNOME Desktop (Shell Wayland)|KDE Plasma (KWin Wayland)|COSMIC Desktop (Pop!_OS Wayland)|Niri (Desktop Completo con Barra DMS)|Sway Compositor|Hyprland Compositor|Labwc Compositor|Wayfire Compositor|River Compositor|LXQt Desktop Wayland|MATE Desktop Wayland|XFCE Desktop Wayland|Weston Compositor|Sessione Grafica X11 (SSH Forwarding con Xwayland)|Terminale Remoto (Rilevamento Automatico)|Terminale Ghostty|Terminale Kitty|Terminale Alacritty|Terminale Foot|Terminale Ptyxis|Terminale GNOME|Terminale Konsole|Comando Personalizzato" \
        --separator="|" 2>/dev/null) || f_status=$?

    if [ "$f_status" -ne 0 ] || [ -z "$form_res" ]; then
        return 0
    fi

    local name host user sess_label
    name=$(echo "$form_res" | cut -d'|' -f1)
    host=$(echo "$form_res" | cut -d'|' -f2)
    user=$(echo "$form_res" | cut -d'|' -f3)
    sess_label=$(echo "$form_res" | cut -d'|' -f4)

    if [ -z "$name" ] || [ -z "$host" ] || [ -z "$user" ]; then
        zenity --error --text="I campi Nome, Host e Utente sono obbligatori." 2>/dev/null || true
        return 0
    fi

    local session_code="auto"
    local custom_cmd=""
    case "$sess_label" in
        *"Rilevamento Automatico"*) session_code="auto" ;;
        *"Cinnamon"*) session_code="cinnamon" ;;
        *"GNOME Desktop"*) session_code="gnome" ;;
        *"Plasma"*) session_code="plasma" ;;
        *"COSMIC"*) session_code="cosmic" ;;
        *"Desktop Completo"*|*"Niri"*) session_code="niri-desktop" ;;
        *"Sway"*) session_code="sway" ;;
        *"Hyprland"*) session_code="hyprland" ;;
        *"Labwc"*) session_code="labwc" ;;
        *"Wayfire"*) session_code="wayfire" ;;
        *"River"*) session_code="river" ;;
        *"LXQt"*) session_code="lxqt" ;;
        *"MATE"*) session_code="mate" ;;
        *"XFCE"*) session_code="xfce" ;;
        *"Weston"*) session_code="weston" ;;
        *"X11"*) session_code="x11" ;;
        *"Terminale Remoto"*) session_code="terminal" ;;
        *"Ghostty"*) session_code="ghostty" ;;
        *"Kitty"*) session_code="kitty" ;;
        *"Alacritty"*) session_code="alacritty" ;;
        *"Foot"*) session_code="foot" ;;
        *"Ptyxis"*) session_code="ptyxis" ;;
        *"Terminale GNOME"*) session_code="gnome-terminal" ;;
        *"Konsole"*) session_code="konsole" ;;
        *"Personalizzato"*)
            session_code="custom"
            custom_cmd=$(zenity --entry --title="Comando Personalizzato" --text="Inserisci il comando da eseguire sul server:" --entry-text="niri" 2>/dev/null || true)
            ;;
    esac

