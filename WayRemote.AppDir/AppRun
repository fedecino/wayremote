    [ -z "$name" ] && name="$CONN_NAME"
    [ -z "$host" ] && host="$CONN_HOST"
    [ -z "$user" ] && user="$CONN_USER"

    local session_code="$CONN_SESSION"
    local custom_cmd="$CONN_CUSTOM_CMD"

    case "$sess_label" in
        *"Mantieni"*) ;;
        *"Rilevamento Automatico"*) session_code="auto" ;;
        *"Cinnamon"*) session_code="cinnamon" ;;
        *"GNOME Desktop"*) session_code="gnome" ;;
        *"Plasma"*) session_code="plasma" ;;
        *"COSMIC"*) session_code="cosmic" ;;
        *"Desktop Completo"*|*"Niri"*) session_code="niri-desktop" ;;
        *"Sway"*) session_code="sway" ;;
        *"Hyprland"*) session_code="hyprland" ;;
        *"Labwc"*) session_code="labwc" ;;
        *"Wayfire"*) session_code="wayfire" ;;
        *"River"*) session_code="river" ;;
        *"LXQt"*) session_code="lxqt" ;;
        *"MATE"*) session_code="mate" ;;
        *"XFCE"*) session_code="xfce" ;;
        *"Weston"*) session_code="weston" ;;
        *"Terminale Remoto"*) session_code="terminal" ;;
        *"Ghostty"*) session_code="ghostty" ;;
        *"Kitty"*) session_code="kitty" ;;
        *"Alacritty"*) session_code="alacritty" ;;
        *"Foot"*) session_code="foot" ;;
        *"Ptyxis"*) session_code="ptyxis" ;;
        *"Terminale GNOME"*) session_code="gnome-terminal" ;;
        *"Konsole"*) session_code="konsole" ;;
        *"Personalizzato"*)
            session_code="custom"
            custom_cmd=$(zenity --entry --title="Comando Personalizzato" --text="Inserisci il comando da eseguire sul server:" --entry-text="${custom_cmd:-niri}" 2>/dev/null || true)
            ;;
    esac

    python3 "$CONNECTIONS_PY" update "$CONN_ID" "$name" "$host" "$user" "$session_code" "$custom_cmd"
}

# Form Elimina Connessione
form_delete_connection() {
    local count
    count=$(python3 "$CONNECTIONS_PY" count 2>/dev/null || echo 0)
    local del_id=""

    if [ "$count" -eq 1 ]; then
        del_id=$(python3 "$CONNECTIONS_PY" first-id 2>/dev/null || echo 1)
    else
        local list_args=()
        while IFS= read -r line; do
            list_args+=("$line")
        done < <(python3 "$CONNECTIONS_PY" list)

        local d_status=0
        del_id=$(zenity --list \
            --title="Elimina Connessione" \
            --text="Seleziona la connessione che desideri eliminare dalla rubrica:" \
            --column="ID" --column="Nome Server" --column="Indirizzo IP / Host" --column="Utente" --column="Tipo Sessione" \
            --hide-column=1 \
            "${list_args[@]}" \
            --ok-label="Elimina" --cancel-label="Annulla" \
            --height=320 --width=680 2>/dev/null) || d_status=$?

        if [ "$d_status" -ne 0 ] || [ -z "$del_id" ]; then
            return 0
        fi
    fi

    local get_vars
    get_vars=$(python3 "$CONNECTIONS_PY" get "$del_id" 2>/dev/null) || true
    eval "$get_vars"
    local cname="${CONN_NAME:-#$del_id}"

    if zenity --question --title="Conferma Eliminazione" --text="Sei sicuro di voler eliminare la connessione <b>$cname</b>?" 2>/dev/null; then
        python3 "$CONNECTIONS_PY" delete "$del_id"
    fi
}

# Connessione Rapida:
# Quando una connessione è già registrata, NON chiede IP e utente, ma chiede SOLO la password!
connect_quick() {
    local count
    count=$(python3 "$CONNECTIONS_PY" count 2>/dev/null || echo 0)

    if [ "$count" -gt 0 ]; then
        local target_id=""
        if [ "$count" -eq 1 ]; then
            target_id=$(python3 "$CONNECTIONS_PY" first-id 2>/dev/null || echo 1)
        else
            # Più profili memorizzati: mostra selezione rapida
            local list_args=()
            while IFS= read -r line; do
                list_args+=("$line")
            done < <(python3 "$CONNECTIONS_PY" list)

            local pick_status=0
            target_id=$(zenity --list \
                --title="Connessione Rapida" \
                --text="Seleziona il computer remoto a cui connetterti:" \
                --column="ID" --column="Nome Server" --column="Indirizzo IP / Host" --column="Utente" --column="Tipo Sessione" \
                --hide-column=1 \
                "${list_args[@]}" \
                --ok-label="Connetti" --cancel-label="Annulla" \
                --height=320 --width=680 2>/dev/null) || pick_status=$?

            if [ "$pick_status" -ne 0 ] || [ -z "$target_id" ]; then
                return 1
            fi
        fi

        # Connessione registrata: chiede SOLO la password tramite connect_profile
        connect_profile "$target_id"
        return $?
    fi

    # Fallback se non ci sono ancora connessioni salvate
    connect_manual
}

# Connessione manuale a un nuovo host non salvato
connect_manual() {
    local remote_ip=""
    local r_status=0
    remote_ip=$(zenity --entry --title="Connessione Manuale" --text="Inserisci l'indirizzo IP del server:" --entry-text="192.168.1." 2>/dev/null) || r_status=$?
    if [ "$r_status" -ne 0 ] || [ -z "$remote_ip" ]; then return 1; fi

    local remote_user=""
    local u_status=0
    remote_user=$(zenity --entry --title="Connessione Manuale" --text="Inserisci il nome utente:" --entry-text="$USER" 2>/dev/null) || u_status=$?
    if [ "$u_status" -ne 0 ] || [ -z "$remote_user" ]; then return 1; fi

    local remote_pass=""
    local p_status=0
    remote_pass=$(zenity --password --title="Password SSH" --text="Inserisci la password per <b>${remote_user}@${remote_ip}</b>:\n<i>(Lascia vuoto se hai già configurato la chiave SSH pubblica)</i>" 2>/dev/null) || p_status=$?
    if [ "$p_status" -ne 0 ]; then return 1; fi

    launch_session "$remote_ip" "$remote_user" "$remote_pass" "auto" ""
    return 0
}

# Connessione a un profilo memorizzato (NON chiede IP o utente, chiede SOLO la password!)
connect_profile() {
    local prof_id="$1"
    local get_vars
    get_vars=$(python3 "$CONNECTIONS_PY" get "$prof_id" 2>/dev/null) || {
        zenity --error --text="Impossibile caricare il profilo selezionato." 2>/dev/null || true
        return 1
    }
    eval "$get_vars"

    local remote_pass=""
    local p_status=0
    remote_pass=$(zenity --password \
        --title="WayRemote - Password per ${CONN_NAME}" \
        --text="Inserisci la password per <b>${CONN_USER}@${CONN_HOST}</b>:\n<i>(Lascia vuoto se hai già configurato la chiave SSH pubblica)</i>" 2>/dev/null) || p_status=$?
    if [ "$p_status" -ne 0 ]; then
        return 1
    fi

    launch_session "$CONN_HOST" "$CONN_USER" "$remote_pass" "$CONN_SESSION" "$CONN_CUSTOM_CMD"
    return 0
}

# Avvio effettivo della sessione Waypipe / SSH
launch_session() {
    local remote_ip="$1"
    local remote_user="$2"
    local remote_pass="$3"
    local session_choice="$4"
    local custom_cmd="$5"

    # Script helper per SSH_ASKPASS
    local askpass_script
    askpass_script=$(mktemp /tmp/wayremote_askpass.XXXXXX.sh)
    chmod 700 "$askpass_script"

    cat << EOF > "$askpass_script"
#!/usr/bin/env bash
PROMPT="\${1:-}"
SAVED_PASS="$remote_pass"

if echo "\$PROMPT" | grep -qiE "yes/no|fingerprint|authenticity"; then
    echo "yes"
elif [ -n "\$SAVED_PASS" ]; then
    echo "\$SAVED_PASS"
else
    zenity --password --title="WayRemote - Autenticazione SSH" --text="\$PROMPT" 2>/dev/null
fi
EOF

    local SSH_OPTS=(-o IPQoS=none -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -o NumberOfPasswordPrompts=1)

    # 1. PRE-FLIGHT CHECK: Verifica Connettività e Credenziali SSH
    local check_output
    check_output=$(export DISPLAY="${DISPLAY:-:0}" SSH_ASKPASS="$askpass_script" SSH_ASKPASS_REQUIRE="force"; \
        ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "echo __WAYREMOTE_AUTH_OK__" 2>&1) || {
        
        if echo "$check_output" | grep -qi "Permission denied"; then
            zenity --error --title="Autenticazione Fallita" \
                --text="<b>Password o Nome Utente non corretti.</b>\n\nImpossibile accedere come utente <b>${remote_user}</b> su <b>${remote_ip}</b>.\nVerifica che la password digitata sia corretta." \
                --width=460
        elif echo "$check_output" | grep -qi "Connection refused"; then
            zenity --error --title="Server Non Raggiungibile" \
                --text="<b>Connessione rifiutata da ${remote_ip}:22.</b>\n\nIl server SSH non risulta in esecuzione sul target.\nSul PC server esegui:\n<tt>sudo systemctl enable --now sshd</tt> (oppure <tt>ssh</tt>)" \
                --width=480
        elif echo "$check_output" | grep -qiE "No route to host|timed out|Could not resolve"; then
            zenity --error --title="Host Non Raggiungibile" \
                --text="<b>Impossibile raggiungere l'indirizzo IP ${remote_ip}.</b>\n\nVerifica che entrambi i PC siano accesi e collegati alla stessa rete LAN o VPN." \
                --width=480
        else
            zenity --error --title="Errore Connessione SSH" \
                --text="<b>Errore di connessione verso ${remote_user}@${remote_ip}:</b>\n\n${check_output}" \
                --width=500
        fi
        rm -f "$askpass_script"
        return 1
    }

    # 2. COSTRUZIONE DEL COMANDO REMOTO
    local remote_cmd=""
    case "$session_choice" in
        auto|"")
            # Script intelligente di rilevamento automatico del DE/WM sul server remoto
            local auto_script='
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    bus_cand="/run/user/$(id -u)/bus"
    [ -S "$bus_cand" ] && export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_cand"
fi

sys_env=$(systemctl --user show-environment 2>/dev/null || true)
xdg_de=$(echo "$sys_env" | grep -E "^XDG_CURRENT_DESKTOP=" | cut -d"=" -f2 | tr "[:upper:]" "[:lower:]" || true)
[ -z "$xdg_de" ] && xdg_de=$(echo "${XDG_CURRENT_DESKTOP:-}" | tr "[:upper:]" "[:lower:]")
sess_de=$(echo "$sys_env" | grep -E "^DESKTOP_SESSION=" | cut -d"=" -f2 | tr "[:upper:]" "[:lower:]" || true)
[ -z "$sess_de" ] && sess_de=$(echo "${DESKTOP_SESSION:-}" | tr "[:upper:]" "[:lower:]")

proc_de=""
if pgrep -u "$USER" -f "cinnamon-session|cinnamon|muffin" >/dev/null 2>&1; then proc_de="cinnamon";
elif pgrep -u "$USER" -x gnome-shell >/dev/null 2>&1; then proc_de="gnome";
elif pgrep -u "$USER" -x kwin_wayland >/dev/null 2>&1; then proc_de="plasma";
elif pgrep -u "$USER" -f "cosmic-comp|cosmic-session" >/dev/null 2>&1; then proc_de="cosmic";
elif pgrep -u "$USER" -x niri >/dev/null 2>&1; then proc_de="niri";
elif pgrep -u "$USER" -x sway >/dev/null 2>&1; then proc_de="sway";
elif pgrep -u "$USER" -i -x hyprland >/dev/null 2>&1; then proc_de="hyprland";
elif pgrep -u "$USER" -x labwc >/dev/null 2>&1; then proc_de="labwc";
elif pgrep -u "$USER" -x wayfire >/dev/null 2>&1; then proc_de="wayfire";
elif pgrep -u "$USER" -x river >/dev/null 2>&1; then proc_de="river";
elif pgrep -u "$USER" -f "lxqt-session" >/dev/null 2>&1; then proc_de="lxqt";
elif pgrep -u "$USER" -f "mate-session" >/dev/null 2>&1; then proc_de="mate";
