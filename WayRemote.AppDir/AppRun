        --add-entry="Nome Utente (attuale: $CONN_USER)" \
        --add-combo="Sessione Remota" \
        --combo-values="Mantieni attuale ($CONN_SESSION)|Rilevamento Automatico DE (Consigliato)|Cinnamon Desktop (Linux Mint Wayland)|GNOME Desktop (Shell Wayland)|KDE Plasma (KWin Wayland)|COSMIC Desktop (Pop!_OS Wayland)|Niri (Desktop Completo con Barra DMS)|Sway Compositor|Hyprland Compositor|Labwc Compositor|Wayfire Compositor|River Compositor|LXQt Desktop Wayland|MATE Desktop Wayland|XFCE Desktop Wayland|Weston Compositor|Terminale Remoto (Rilevamento Automatico)|Terminale Ghostty|Terminale Kitty|Terminale Alacritty|Terminale Foot|Terminale Ptyxis|Terminale GNOME|Terminale Konsole|Comando Personalizzato" \
        --separator="|" 2>/dev/null) || f_status=$?

    if [ "$f_status" -ne 0 ] || [ -z "$form_res" ]; then
