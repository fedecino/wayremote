export XDG_CURRENT_DESKTOP="XFCE"
export DESKTOP_SESSION="xfce"
export XDG_SESSION_TYPE="wayland"
for cf in /usr/share/wayland-sessions/*xfce*.desktop; do
    if [ -f "$cf" ]; then
        cmd=$(grep -E "^Exec=" "$cf" 2>/dev/null | head -n1 | cut -d"=" -f2- | sed -E "s/%[a-zA-Z]//g" | sed "s/^[ \t]*//;s/[ \t]*$//")
        [ -n "$cmd" ] && exec $cmd
    fi
done
exec xfce4-session
'
                local b64_xfce
                b64_xfce=$(echo "$xfce_script" | base64 -w 0)
                remote_cmd="bash -c \"echo '$b64_xfce' | base64 -d | bash\""
                ;;
            weston)
                remote_cmd="weston"
                ;;
            terminal)
                local term_script='
# Ottimizzazioni Ambiente WayRemote
export NO_AT_SPI=1
export GTK_A11Y=none
export QT_ACCESSIBILITY=0
export GDK_BACKEND="wayland,x11,*"
export QT_QPA_PLATFORM="wayland;xcb"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
export CHROME_OZONE_PLATFORM_HINT="auto"
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    bus_cand="/run/user/$(id -u)/bus"
    if [ -S "$bus_cand" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_cand"
    elif command -v dbus-launch >/dev/null 2>&1; then
        eval "$(dbus-launch --sh-syntax 2>/dev/null)"
    fi
fi

term_bin=""
if [ -n "$TERMINAL" ] && command -v "$TERMINAL" >/dev/null 2>&1; then
    term_bin="$TERMINAL"
elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    term_bin="xdg-terminal-exec"
elif command -v x-terminal-emulator >/dev/null 2>&1; then
    term_bin="x-terminal-emulator"
else
    for cand_t in ghostty kitty alacritty foot ptyxis wezterm gnome-terminal konsole xfce4-terminal mate-terminal lxterminal terminator tilix xterm rxvt urxvt; do
        if command -v "$cand_t" >/dev/null 2>&1; then
            term_bin="$cand_t"
            break
        fi
    done
fi
term_bin="${term_bin:-xterm}"
exec "$term_bin"
'
                local b64_term
                b64_term=$(echo "$term_script" | base64 -w 0)
                remote_cmd="bash -c \"echo '$b64_term' | base64 -d | bash\""
                ;;
            ghostty|kitty|alacritty|foot|ptyxis|wezterm|gnome-terminal|konsole|xfce4-terminal|xterm)
                local st_script='
export NO_AT_SPI=1
export GTK_A11Y=none
export QT_ACCESSIBILITY=0
export GDK_BACKEND="wayland,x11,*"
export QT_QPA_PLATFORM="wayland;xcb"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
export CHROME_OZONE_PLATFORM_HINT="auto"
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    bus_cand="/run/user/$(id -u)/bus"
    if [ -S "$bus_cand" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_cand"
    elif command -v dbus-launch >/dev/null 2>&1; then
        eval "$(dbus-launch --sh-syntax 2>/dev/null)"
    fi
fi
exec '"$session_choice"'
'
                local b64_st
                b64_st=$(echo "$st_script" | base64 -w 0)
                remote_cmd="bash -c \"echo '$b64_st' | base64 -d | bash\""
                ;;
            custom)
                local target_cmd="${custom_cmd:-niri}"
                local cust_script='
export NO_AT_SPI=1
export GTK_A11Y=none
export QT_ACCESSIBILITY=0
export GDK_BACKEND="wayland,x11,*"
export QT_QPA_PLATFORM="wayland;xcb"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
export CHROME_OZONE_PLATFORM_HINT="auto"
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    bus_cand="/run/user/$(id -u)/bus"
    if [ -S "$bus_cand" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_cand"
    elif command -v dbus-launch >/dev/null 2>&1; then
        eval "$(dbus-launch --sh-syntax 2>/dev/null)"
    fi
fi
exec '"$target_cmd"'
'
                local b64_cust
                b64_cust=$(echo "$cust_script" | base64 -w 0)
                remote_cmd="bash -c \"echo '$b64_cust' | base64 -d | bash\""
                ;;
            *)
                remote_cmd="$session_choice"
                ;;
        esac
    fi

    # Garantisci che qualsiasi comando remoto erediti l'ambiente ottimizzato (evita freeze D-Bus/AT-SPI)
    if [[ ! "$remote_cmd" =~ ^bash\ -c ]]; then
        local raw_wrap="export NO_AT_SPI=1; export GTK_A11Y=none; export QT_ACCESSIBILITY=0; export GDK_BACKEND='wayland,x11,*'; export QT_QPA_PLATFORM='wayland;xcb'; export CLUTTER_BACKEND='wayland'; export SDL_VIDEODRIVER='wayland'; export ELECTRON_OZONE_PLATFORM_HINT='auto'; export CHROME_OZONE_PLATFORM_HINT='auto'; export MOZ_ENABLE_WAYLAND=1; export _JAVA_AWT_WM_NONREPARENTING=1; [ -z \"\$DBUS_SESSION_BUS_ADDRESS\" ] && [ -S \"/run/user/\$(id -u)/bus\" ] && export DBUS_SESSION_BUS_ADDRESS=\"unix:path=/run/user/\$(id -u)/bus\"; "
        remote_cmd="bash -c \"${raw_wrap} exec ${remote_cmd}\""
    fi

    # 4. AVVIO SESSIONE GRAFICA (WAYPIPE O SSH X11 FORWARDING)
    local session_log="/tmp/wayremote_session.log"
    rm -f "$session_log"

    if command -v notify-send &>/dev/null; then
        if [ "$conn_mode" = "x11" ]; then
            notify-send "WayRemote" "Avvio sessione X11 su ${remote_user}@${remote_ip}..."
        else
            notify-send "WayRemote" "Avvio sessione '${session_choice}' su ${remote_user}@${remote_ip}..."
        fi
    fi

    (
        export SSH_ASKPASS="$askpass_script"
        export SSH_ASKPASS_REQUIRE="force"

        local wp_extra=()
        if [ "$srv_xwls" -eq 1 ]; then
            wp_extra+=(--xwls)
        fi

        if [ "$conn_mode" = "wayland" ]; then
            echo "==> [WayRemote] Avvio sessione Wayland ($session_choice) su $remote_user@$remote_ip" > "$session_log"

            local can_use_video=0
            if [ "$cli_wp_video" -eq 1 ] && [ "$srv_wp_video" -eq 1 ]; then
                can_use_video=1
            fi

            if [ "$is_lan" -eq 1 ]; then
                echo "==> [WayRemote] Rete LAN rilevata: Ottimizzazione High-Throughput & Low-Latency" >> "$session_log"

                if [ "$can_use_video" -eq 1 ]; then
                    echo "==> [WayRemote] Accelerazione GPU Hardware (Video H.264 via VA-API/NVENC) attiva" >> "$session_log"
                    # Tentativo 1 (LAN): Hardware Video Encoding H.264 con bitrate ottimizzato per LAN
                    if waypipe --threads=0 --video=h264,hw,bpf=800000 -c lz4=1 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                        exit 0
                    fi

                    # Tentativo 2 (LAN): Software Video Encoding H.264 fallback
                    if waypipe --threads=0 --video=h264,bpf=600000 -c lz4=1 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                        exit 0
                    fi
                fi

                # Tentativo 3 (LAN): Fallback compressione LZ4 (se video non supportato)
                if waypipe --threads=0 -c lz4=1 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                    exit 0
                fi

                # Tentativo 4 (LAN): Fallback memoria software senza GPU
                if waypipe --threads=0 --no-gpu -c lz4=1 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                    exit 0
                fi
            else
                echo "==> [WayRemote] Connessione remota/WAN: Compressione video/LZ4 ottimizzata multithread" >> "$session_log"

                if [ "$can_use_video" -eq 1 ]; then
                    # Tentativo 1 (WAN): Video H.264 HW con bitrate controllato (~15 Mbps)
                    if waypipe --threads=0 --video=h264,hw,bpf=250000 -c lz4=1 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                        exit 0
                    fi

                    # Tentativo 2 (WAN): Video H.264 SW con bitrate controllato
                    if waypipe --threads=0 --video=h264,bpf=200000 -c lz4=1 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                        exit 0
                    fi
                fi

                # Tentativo 3 (WAN): Compressione standard lz4
                if waypipe --threads=0 -c lz4 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                    exit 0
                fi

                # Tentativo 4 (WAN): Fallback software senza GPU
                if waypipe --threads=0 --no-gpu -c lz4 "${wp_extra[@]}" ssh "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1; then
                    exit 0
                fi
            fi

            # Fallback automatico su SSH X11 Forwarding se waypipe fallisce sul server
            echo "==> [WayRemote] Fallback automatico su SSH X11 Forwarding..." >> "$session_log"
            ssh -Y -o ForwardX11Timeout=0 "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "nemo || nautilus || thunar || x-terminal-emulator || xterm" >> "$session_log" 2>&1
        else
            echo "==> [WayRemote] Avvio sessione X11 (SSH Forwarding con accelerazione crittografica hardware) su $remote_user@$remote_ip" > "$session_log"
            ssh -Y -o ForwardX11Timeout=0 "${SSH_OPTS[@]}" "$remote_user@$remote_ip" "$remote_cmd" >> "$session_log" 2>&1
        fi
    )
    local wp_exit=$?

    if [ "$wp_exit" -ne 0 ]; then
        if [ -s "$session_log" ]; then
            if grep -qi "X11 forwarding request failed" "$session_log"; then
                zenity --warning --title="Inoltro X11 Non Abilitato sul Server" \
                    --text="<b>Il server remoto non ha abilitato l'inoltro grafico X11.</b>\n\nPer abilitarlo, esegui sul server:\n1. Aggiungi <tt>X11Forwarding yes</tt> in <tt>/etc/ssh/sshd_config</tt>\n2. Installa il pacchetto <tt>xauth</tt> (es. <tt>sudo apt install xauth</tt>)\n3. Riavvia SSH: <tt>sudo systemctl restart ssh</tt>" \
                    --width=480 2>/dev/null || true
            else
                zenity --text-info --title="Log Sessione WayRemote" \
                    --filename="$session_log" \
                    --width=620 --height=400 2>/dev/null || true
            fi
        fi
    fi

    # Pulizia file temporanei
    rm -f "$askpass_script"
    return "$wp_exit"
}

# Menu principale interattivo
main_menu() {
    local choice
    choice=$(zenity --list --radiolist \
        --title="WayRemote - Remote Login Wayland" \
        --text="Seleziona l'operazione desiderata:" \
        --column="Seleziona" --column="Codice" --column="Operazione" \
        TRUE  "CLIENT"  "1. Connettiti a un PC remoto (Client)" \
        FALSE "SERVER"  "2. Configura questo PC come SERVER (riceve connessioni)" \
        FALSE "INSTALL" "3. Installa WayRemote nel sistema (Integrazione Desktop)" \
        --height=240 --width=520 --hide-column=2) || exit 0

    case "$choice" in
        CLIENT)
            flow_client
            ;;
        SERVER)
            flow_server
            ;;
        INSTALL)
            flow_install
            ;;
        *)
            exit 0
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Entry Point
# ------------------------------------------------------------------------------
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo "Uso: wayremote [OPZIONE]"
    echo
    echo "Utility Universale per Remote Login nativo Wayland via waypipe e SSH."
    echo
    echo "Opzioni:"
    echo "  --client,  -c   Avvia direttamente la procedura di connessione client"
    echo "  --server,  -s   Configura la macchina locale come server di ricezione"
    echo "  --install, -i   Installa e integra WayRemote nel desktop dell'utente"
    echo "  --help,    -h   Mostra questa guida"
    exit 0
fi

# Verifica e autoinstalla zenity e fuse2 per la GUI e il runtime se mancanti
ensure_system_dependencies

# Gestione degli altri argomenti da riga di comando
if [ $# -gt 0 ]; then
    case "$1" in
        --client|-c)
            flow_client
            ;;
        --server|-s)
            flow_server
            ;;
        --install|-i)
            flow_install
            ;;
        *)
            echo "Opzione non riconosciuta: $1" >&2
            echo "Usa '$0 --help' per visualizzare le opzioni disponibili." >&2
            exit 1
            ;;
    esac
else
    main_menu
fi
